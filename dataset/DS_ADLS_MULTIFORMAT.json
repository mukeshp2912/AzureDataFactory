		},
		"parameters": {
			"FOLDER": {
				"type": "string"
			},
			"FILE": {
				"type": "string"
			}
		},
		"folder": {
			"name": "ADLS"
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().FILE",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().FOLDER",
					"type": "Expression"
				},
				"fileSystem": "mycontainer"
			}
		}
	}
}